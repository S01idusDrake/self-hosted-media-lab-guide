# Requires a private notification route; no notification is delivered by this file alone.
groups:
  - name: basic-availability
    rules:
      - alert: ScrapeTargetDown
        expr: up == 0
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "A configured scrape target is down"
      - alert: ApplicationProbeFailed
        expr: probe_success == 0
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "An application probe is failing"
# Add expected-target absence, collector freshness, disk and backup rules only
# after selecting/testing the actual metric names and labels.
